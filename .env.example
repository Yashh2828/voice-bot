# ====================================
# Voice Bot 100X - Environment Configuration
# ====================================

# ===== API CONFIGURATION =====
# Required: Your Google Gemini API key
# Get one from: https://ai.google.dev/
GEMINI_API_KEY=your_actual_gemini_api_key_here

# LLM Model Selection (choose one)
# Recommended stable models:
# - gemini-2.5-flash (Latest stable, fast and efficient)
# - gemini-2.5-pro (Latest stable, highest quality)
# - gemini-2.0-flash (Stable, good balance)
# Experimental models:
# - gemini-2.0-flash-exp (Latest experimental features)
GEMINI_MODEL=gemini-2.5-flash

# API Base URL (usually doesn't need to be changed)
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ===== MODEL PARAMETERS =====
# Temperature (0.0 to 1.0) - Controls creativity/randomness
MODEL_TEMPERATURE=0.7

# Top K sampling (1 to 100) - Limits token choices
MODEL_TOP_K=40

# Top P sampling (0.0 to 1.0) - Nucleus sampling
MODEL_TOP_P=0.95

# Maximum output tokens (1 to 2048)
MODEL_MAX_OUTPUT_TOKENS=1024

# ===== PERSONA CONFIGURATION =====
# AI Assistant Name
AI_NAME=Yash Sinha

# AI Assistant Role/Description
AI_ROLE=final-year B.Tech AI/ML student

# AI Response Style
AI_STYLE=friendly, confident, and clear

# ===== SECURITY & RATE LIMITING =====
# Maximum input length in characters
MAX_INPUT_LENGTH=500

# Maximum requests per minute per IP
MAX_REQUESTS_PER_MINUTE=20

# API request timeout in seconds
REQUEST_TIMEOUT=10

# Number of retry attempts for failed API calls
RETRY_ATTEMPTS=3

# Delay between retry attempts in seconds
RETRY_DELAY=1

# ===== SERVER CONFIGURATION =====
# Flask debug mode (true/false)
FLASK_DEBUG=false

# Server port (default is 5000)
PORT=5000

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Environment (development/production/testing)
ENVIRONMENT=production

# ===== SAFETY SETTINGS =====
# Safety threshold levels: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
SAFETY_HARASSMENT=BLOCK_MEDIUM_AND_ABOVE
SAFETY_HATE_SPEECH=BLOCK_MEDIUM_AND_ABOVE
SAFETY_SEXUALLY_EXPLICIT=BLOCK_MEDIUM_AND_ABOVE
SAFETY_DANGEROUS_CONTENT=BLOCK_MEDIUM_AND_ABOVE

# ===== LOGGING =====
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable API request logging (true/false)
LOG_API_REQUESTS=false